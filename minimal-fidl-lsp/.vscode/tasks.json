{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{	
			"label": "build-lsp-server",
			"command": "cd minimal-fidl-lsp-server && cargo build && cd ../",
			"type": "shell",
			"group": "build",
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc-watch"
			]
		},
		{
			"label": "buildAndWatch",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build-lsp-server",
				{
					"type": "npm",
					"script": "watch"
				}
			]
		}
	]
}